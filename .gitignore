# ============================================
# Uma Crown Simulator - Git 追跡除外設定
# ============================================
# Git が追跡しないファイル・ディレクトリを定義する。
# 生成物・依存パッケージ・秘匿情報・OS固有ファイルなど
# リポジトリに含めるべきでないものを除外する。
# ============================================

# --- ビルド生成物（ソースから再生成可能なため追跡不要）---
dist/
build/
out-tsc/
bazel-out/
tmp/

# --- 依存パッケージ（npm ci で再インストール可能）---
node_modules/

# --- ログファイル（実行時生成物。リポジトリに含めない）---
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# --- テストカバレッジ（CI で都度生成。リポジトリに含めない）---
coverage/
.nyc_output/

# --- 環境変数ファイル（秘匿情報を含むためリポジトリに含めない）---
.env
.env.*.local
!.env.example

# --- OS 固有ファイル（開発者のローカル環境依存）---
.DS_Store
Thumbs.db

# --- IDE 設定（開発者ごとに異なるため共有しない）---
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.history/
**/.vscode/

# --- Angular 固有（開発用設定とキャッシュ）---
# development.ts は .env.example から各自生成する（秘匿情報を含むため）
frontend/src/app/environments/environment.development.ts
**/.angular/
.sass-cache/
connect.lock
libpeerconnection.log
testem.log
typings/
__screenshots__/

# --- ランタイムデータ（プロセス実行時の一時ファイル）---
pids/
*.pid
*.seed
*.pid.lock

# --- 一時ファイル ---
.temp/
.tmp/

# --- Node.js 診断レポート ---
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# --- Docker（docker-compose の named volume がホストに作るデータ）---
postgres_data/

# --- Kubernetes（秘匿情報を含む secret マニフェスト）---
k8s/secret.yaml

# --- スクリプト（ローカル用の一時スクリプト。リポジトリに含めない）---
script/

# --- Terraform（状態ファイルは秘匿情報を含む。.terraform/ はプロバイダキャッシュ）---
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.backup
terraform/.terraform.lock.hcl
terraform/terraform.tfvars
