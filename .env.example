# ============================================
# Uma Crown Simulator - 環境変数テンプレート
# ============================================
# このファイルを .env にコピーして値を設定する。
# .env は .gitignore で追跡対象外（秘匿情報の漏洩防止）。
# docker-compose.yml が env_file で .env を読み込む。
# ============================================

# --- PostgreSQL 接続情報 ---
# backend が Prisma 経由で接続する DB の URL（docker-compose の postgres サービスに対応）
DATABASE_URL=postgresql://uma_crown:uma_crown_dev@localhost:5432/uma_crown
# postgres コンテナの初期化時に使用するユーザー・パスワード・DB名
POSTGRES_USER=uma_crown
POSTGRES_PASSWORD=uma_crown_dev
POSTGRES_DB=uma_crown

# --- AWS Cognito 認証 ---
# バックエンドの JWT 検証に使用。AWS コンソールから取得する
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=your-client-id

# --- CORS 許可オリジン ---
# バックエンドが受け付けるフロントエンドのオリジン（カンマ区切りで複数指定可）
CORS_ORIGIN=http://localhost:4200,http://127.0.0.1:4200

# --- Node.js 実行モード ---
# development: Pino ログが pino-pretty で整形される / production: JSON ログ
NODE_ENV=development
