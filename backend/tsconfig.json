{
  "compilerOptions": {
    // --- モジュールシステム ---
    // ESM ネイティブ実行のため nodenext を指定（NestJS を ESM モードで動かす前提）
    "module": "nodenext",
    // nodenext に合わせた解決戦略（.js 拡張子の明示が必須になる）
    "moduleResolution": "nodenext",
    // package.json の exports フィールドを尊重する（ESM パッケージの正しい解決に必要）
    "resolvePackageJsonExports": true,
    // CommonJS モジュールの default import を許可する（nestjs-pino 等の CJS パッケージ互換）
    "esModuleInterop": true,
    // CommonJS の default export を import 文で直接受け取れるようにする（esModuleInterop の補完）
    "allowSyntheticDefaultImports": true,
    // ファイル単位のトランスパイルを強制する（SWC / esbuild との互換性確保）
    "isolatedModules": true,

    // --- 出力設定 ---
    // 型定義ファイルを出力する（shared パッケージ等から参照される場合に必要）
    "declaration": true,
    // コメントをビルド成果物から除去する（本番バンドルサイズ削減）
    "removeComments": true,
    // ソースマップを出力する（本番エラー時のスタックトレースで元ファイル位置を特定するため）
    "sourceMap": true,
    // ビルド成果物の出力先
    "outDir": "./dist",

    // --- デコレーター ---
    // NestJS のデコレーター（@Controller, @Injectable 等）に必要
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,

    // --- コンパイルターゲット ---
    // Node.js 20 がサポートする ES2023 を指定（不要なポリフィルを排除）
    "target": "ES2023",

    // --- パスエイリアス ---
    // tsc-alias がビルド時に相対パスに変換する。import 文の可読性向上
    "baseUrl": "./",
    "paths": {
      "@shared/*": ["../shared/*"],
      "@common/*": ["src/common/*"],
      "@src/*": ["src/*"]
    },

    // --- ビルド高速化 ---
    // 前回ビルドの情報を再利用してコンパイル時間を短縮する
    "incremental": true,
    // node_modules 内の型定義チェックをスキップする（ビルド高速化。ライブラリ型エラーを無視）
    "skipLibCheck": true,

    // --- 型安全性 ---
    // null / undefined の区別を厳密にする（NullPointerException 相当のバグを防止）
    "strictNullChecks": true,
    // ファイル名の大文字小文字を OS 間で統一する（macOS ↔ Linux での不一致防止）
    "forceConsistentCasingInFileNames": true,
    // 暗黙の any を禁止する（コーディング規約 §1-3 の機械強制）
    "noImplicitAny": true,
    // bind/call/apply の型チェックを緩和する（NestJS の内部利用パターンとの互換性）
    "strictBindCallApply": false,
    // switch の fallthrough を許可する（意図的な fallthrough パターンを使用する箇所があるため）
    "noFallthroughCasesInSwitch": false
  }
}
